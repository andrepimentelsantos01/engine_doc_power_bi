table Produtos
    description: Cadastro simplificado de produtos

    column ProdutoId
        dataType: int64
        sourceColumn: ProdutoId

    column Produto
        dataType: string
        sourceColumn: Produto

    column Categoria
        dataType: string
        sourceColumn: Categoria

    partition Produtos = m
        mode: import
        sourceType: m
        expression: let Fonte = #table({"ProdutoId", "Produto", "Categoria"}, {{1, "Notebook", "Tecnologia"}, {2, "Cadeira", "Móveis"}}) in Fonte

